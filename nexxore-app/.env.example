# ── Web (apps/web) ───────────────────────────────────────────────
# Public base URL of the site. Used for canonical URLs, sitemap, robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base URL of the API gateway the web app talks to.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── API (apps/api) ───────────────────────────────────────────────
# Port the Fastify gateway listens on.
API_PORT=4000
# Public URL advertised in the OpenAPI spec.
# API_PUBLIC_URL=https://api.nexxore.xyz
# Postgres — backs the stats table (db/migrations + `pnpm --filter @nexxore/api seed`).
# Unset → seeded in-memory repo (local dev/CI without infra).
# DATABASE_URL=postgres://user:pass@localhost:5432/nexxore
# Redis — backs distributed rate limiting. Unset → in-memory store (single instance).
# REDIS_URL=redis://localhost:6379
# Public per-IP rate limit (requests per window).
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW=1 minute

# ── Bot (apps/bot) — scaffold only, not deployed yet ─────────────
# TELEGRAM_BOT_TOKEN=
