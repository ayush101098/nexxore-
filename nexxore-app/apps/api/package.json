{
  "name": "@nexxore/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "tsx scripts/generate-openapi.ts",
    "seed": "tsx scripts/seed.ts",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/swagger": "8.15.0",
    "@fastify/type-provider-typebox": "4.1.0",
    "@sinclair/typebox": "0.32.35",
    "fastify": "4.28.1",
    "ioredis": "5.4.1",
    "pg": "8.13.0"
  },
  "devDependencies": {
    "@nexxore/config": "workspace:*",
    "@types/node": "20.16.5",
    "@types/pg": "8.11.10",
    "autocannon": "7.15.0",
    "eslint": "8.57.1",
    "tsx": "4.19.1",
    "typescript": "5.5.4",
    "vitest": "2.1.1"
  }
}
