    "@storybook/addon-essentials": "8.3.2",
    "@storybook/react": "8.3.2",
    "@storybook/react-vite": "8.3.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "8.3.2",
    "typescript": "5.5.4",
    "vite": "5.4.7",
    "vitest": "2.1.1"
