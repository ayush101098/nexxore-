{
  "version": "0.1.0",
  "name": "nexxore_perps",
  "instructions": [
    {
      "name": "initialize",
      "accounts": [
        { "name": "state", "isMut": true, "isSigner": false },
        { "name": "collateralMint", "isMut": false, "isSigner": false },
        { "name": "vault", "isMut": false, "isSigner": false },
        { "name": "authority", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": []
    },
    {
      "name": "depositMargin",
      "accounts": [
        { "name": "state", "isMut": true, "isSigner": false },
        { "name": "margin", "isMut": true, "isSigner": false },
        { "name": "vault", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true },
        { "name": "userTokenAccount", "isMut": true, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [{ "name": "amount", "type": "u64" }]
    },
    {
      "name": "withdrawMargin",
      "accounts": [
        { "name": "state", "isMut": true, "isSigner": false },
        { "name": "margin", "isMut": true, "isSigner": false },
        { "name": "vault", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true },
        { "name": "userTokenAccount", "isMut": true, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false }
      ],
      "args": [{ "name": "amount", "type": "u64" }]
    },
    {
      "name": "openPosition",
      "accounts": [
        { "name": "state", "isMut": true, "isSigner": false },
        { "name": "margin", "isMut": true, "isSigner": false },
        { "name": "position", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "marketId", "type": "u64" },
        { "name": "size", "type": "i64" },
        { "name": "entryPrice", "type": "u64" },
        { "name": "marginAmount", "type": "u64" },
        { "name": "leverage", "type": "u16" },
        { "name": "isLong", "type": "bool" }
      ]
    },
    {
      "name": "closePosition",
      "accounts": [
        { "name": "state", "isMut": true, "isSigner": false },
        { "name": "margin", "isMut": true, "isSigner": false },
        { "name": "position", "isMut": true, "isSigner": false },
        { "name": "user", "isMut": true, "isSigner": true }
      ],
      "args": [{ "name": "exitPrice", "type": "u64" }]
    }
  ],
  "accounts": [
    {
      "name": "state",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "authority", "type": "publicKey" },
          { "name": "collateralMint", "type": "publicKey" },
          { "name": "vault", "type": "publicKey" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "marginAccount",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "owner", "type": "publicKey" },
          { "name": "balance", "type": "u64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "position",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "owner", "type": "publicKey" },
          { "name": "marketId", "type": "u64" },
          { "name": "size", "type": "i64" },
          { "name": "entryPrice", "type": "u64" },
          { "name": "exitPrice", "type": "u64" },
          { "name": "margin", "type": "u64" },
          { "name": "leverage", "type": "u16" },
          { "name": "isLong", "type": "bool" },
          { "name": "open", "type": "bool" },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ]
