# perps service: copy to .env.production and fill in. Never commit it (gitignored).
# Production Environment Variables
# Copy this to .env and fill in your actual values

# ═══════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════
DATABASE_URL=
# For production, use connection pooling:
# DATABASE_URL=postgresql://username:password@host:5432/nexxore_prod?sslmode=require&pool_max=20

# ═══════════════════════════════════════════════════════════
# PERPS SERVICE CONFIGURATION
# ═══════════════════════════════════════════════════════════
PERPS_PORT=
NODE_ENV=

# ═══════════════════════════════════════════════════════════
# HYPERLIQUID API CONFIGURATION
# ═══════════════════════════════════════════════════════════
USE_HYPERLIQUID=
HYPERLIQUID_API_URL=
HYPERLIQUID_TESTNET_API_URL=

# Top 20 Markets (production ready)
PERPS_MARKETS=

# ═══════════════════════════════════════════════════════════
# RISK PARAMETERS
# ═══════════════════════════════════════════════════════════
PERPS_MAX_LEVERAGE=
PERPS_MAINT_MARGIN=
PERPS_MAKER_FEE=
PERPS_TAKER_FEE=

# ═══════════════════════════════════════════════════════════
# WALLET INTEGRATION
# ═══════════════════════════════════════════════════════════
# EVM Configuration
EVM_RPC_URL=
EVM_CHAIN_ID=

# Solana Configuration
SOLANA_RPC_URL=
SOLANA_WS_URL=

# ═══════════════════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════════════════
# JWT secret for API authentication (generate with: openssl rand -hex 32)
JWT_SECRET=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# ═══════════════════════════════════════════════════════════
# MONITORING & LOGGING
# ═══════════════════════════════════════════════════════════
LOG_LEVEL=
ENABLE_METRICS=
METRICS_PORT=

# Sentry for error tracking (optional)
SENTRY_DSN=

# ═══════════════════════════════════════════════════════════
# REDIS (for caching and session management)
# ═══════════════════════════════════════════════════════════
REDIS_URL=
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════
# WEBSOCKET CONFIGURATION
# ═══════════════════════════════════════════════════════════
WS_PORT=
WS_HEARTBEAT_INTERVAL=
WS_MAX_CONNECTIONS=

# ═══════════════════════════════════════════════════════════
# FALLBACK DATA SOURCES
# ═══════════════════════════════════════════════════════════
PERPS_MARKET_WS=

# ═══════════════════════════════════════════════════════════
# DEVELOPMENT/TESTING (Set to false in production)
# ═══════════════════════════════════════════════════════════
ENABLE_DEBUG_ENDPOINTS=
ENABLE_TEST_ORDERS=
MOCK_TRADING=
