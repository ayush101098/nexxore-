# Production Environment Variables
# Copy this to .env and fill in your actual values

# ═══════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════
DATABASE_URL=postgresql://username:password@localhost:5432/nexxore_prod
# For production, use connection pooling:
# DATABASE_URL=postgresql://username:password@host:5432/nexxore_prod?sslmode=require&pool_max=20

# ═══════════════════════════════════════════════════════════
# PERPS SERVICE CONFIGURATION
# ═══════════════════════════════════════════════════════════
PERPS_PORT=3010
NODE_ENV=production

# ═══════════════════════════════════════════════════════════
# HYPERLIQUID API CONFIGURATION
# ═══════════════════════════════════════════════════════════
USE_HYPERLIQUID=true
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_TESTNET_API_URL=https://api.hyperliquid-testnet.xyz

# Top 20 Markets (production ready)
PERPS_MARKETS=BTC,ETH,SOL,HYPE,ARB,OP,AVAX,MATIC,DOGE,LINK,UNI,ATOM,LTC,BCH,ETC,FIL,APT,STX,INJ,TIA

# ═══════════════════════════════════════════════════════════
# RISK PARAMETERS
# ═══════════════════════════════════════════════════════════
PERPS_MAX_LEVERAGE=50
PERPS_MAINT_MARGIN=0.005
PERPS_MAKER_FEE=0.0002
PERPS_TAKER_FEE=0.0006

# ═══════════════════════════════════════════════════════════
# WALLET INTEGRATION
# ═══════════════════════════════════════════════════════════
# EVM Configuration
EVM_RPC_URL=https://arb1.arbitrum.io/rpc
EVM_CHAIN_ID=42161

# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# ═══════════════════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════════════════
# JWT secret for API authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your-secret-key-here-change-this-in-production

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://nexxore.xyz,https://www.nexxore.xyz

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ═══════════════════════════════════════════════════════════
# MONITORING & LOGGING
# ═══════════════════════════════════════════════════════════
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_PORT=9090

# Sentry for error tracking (optional)
SENTRY_DSN=

# ═══════════════════════════════════════════════════════════
# REDIS (for caching and session management)
# ═══════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════
# WEBSOCKET CONFIGURATION
# ═══════════════════════════════════════════════════════════
WS_PORT=3011
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=10000

# ═══════════════════════════════════════════════════════════
# FALLBACK DATA SOURCES
# ═══════════════════════════════════════════════════════════
PERPS_MARKET_WS=wss://stream.binance.com:9443/stream

# ═══════════════════════════════════════════════════════════
# DEVELOPMENT/TESTING (Set to false in production)
# ═══════════════════════════════════════════════════════════
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_TEST_ORDERS=false
MOCK_TRADING=false
