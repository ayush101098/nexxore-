# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PROGRAM_ID=NexxVau1t111111111111111111111111111111111

# Bitcoin Configuration
BTC_API_URL=https://blockstream.info/api
BTC_POLL_INTERVAL=60000

# Vault Addresses (JSON format)
EVM_VAULTS={"mainnet":{"ETH":"0x...","USDC":"0x..."},"polygon":{"USDC":"0x..."}}

# Deployment Blocks (for historical indexing)
DEPLOYMENT_BLOCKS={"mainnet":{"ETH":12345678},"polygon":{"USDC":23456789}}

# Server Configuration
PORT=3001
NODE_ENV=production

# Perps Service
PERPS_PORT=3010
PERPS_MARKET_WS=wss://stream.binance.com:9443/stream
PERPS_MARKETS=btcusdt,ethusdt,solusdt
