PERPS_MAX_LEVERAGE=50
PERPS_MAKER_FEE=0.0002
PERPS_TAKER_FEE=0.0006
PERPS_EVM_RPC=
PERPS_SOLANA_RPC=
PERPS_EVM_CONTRACT=
PERPS_SOLANA_PROGRAM=
PERPS_SOLANA_FEE_PAYER_SECRET=
