# Nexxore Market Data Service - Environment Variables
# =====================================================

# Redis (optional - falls back to in-memory cache)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true

# Database (defaults to SQLite)
DATABASE_URL=sqlite:///data/market_data.db
DB_PATH=data/market_data.db

# Service
MARKET_DATA_HOST=0.0.0.0
MARKET_DATA_PORT=3860
DEBUG=false
LOG_LEVEL=INFO

# Polling
POLL_INTERVAL=10

# Optional: Moralis API key for holder data
MORALIS_API_KEY=
