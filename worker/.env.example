# Supabase — service role key is server-side only, never sent to a browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
BULL_MODEL=claude-sonnet-5-5
BEAR_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-opus-5-5
BULL_EFFORT=low
BEAR_EFFORT=low
JUDGE_EFFORT=medium
# USD per million tokens. Update when models or prices change.
MODEL_PRICES_JSON={"claude-sonnet-5-5":{"input":2,"output":10},"claude-opus-5-5":{"input":4,"output":20}}

# Limits
DAILY_LLM_BUDGET_USD=10
PER_FORECAST_RESERVE_USD=0.15
MAX_MARKETS_PER_DAY=200
CALL_THRESHOLD_CENTS=3

# Optional: private ops alerts when a run fails
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
