# Supabase — service role key is server-side only, never sent to a browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local runs: write the ledger to a JSON file instead of Supabase
# LEDGER_FILE=./ledger.json

# Optional: a different fitted model (default: worker/model/calibration.json)
# CALIBRATION_FILE=

MAX_MARKETS_PER_DAY=200
CALL_THRESHOLD_CENTS=3

# Optional: private ops alerts when a run fails
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
