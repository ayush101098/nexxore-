# ─── TimescaleDB ─────────────────────────────────────
POSTGRES_USER=nexxore
POSTGRES_PASSWORD=nexxore_dev_2026
POSTGRES_DB=nexxore_mcp
TIMESCALE_PORT=5433
DATABASE_URL=postgresql://nexxore:nexxore_dev_2026@localhost:5433/nexxore_mcp

# ─── Hyperliquid ─────────────────────────────────────
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_REST_URL=https://api.hyperliquid.xyz/info

# ─── Ingestion Config ────────────────────────────────
# Coins to subscribe (comma-separated, or "all" for full universe)
INGEST_COINS=all
# Batch size for DB writes
INGEST_BATCH_SIZE=500
# Flush interval in seconds
INGEST_FLUSH_INTERVAL=2
# Max wallets to index per cycle
WALLET_INDEX_BATCH=100
# Fill indexer poll interval in seconds
FILL_INDEX_INTERVAL=60

# ─── Cohort Engine ───────────────────────────────────
# Recompute interval in seconds (default 5 min)
COHORT_RECOMPUTE_INTERVAL=300
# Minimum trades to classify a wallet
COHORT_MIN_TRADES=10

# ─── MCP Server ──────────────────────────────────────
MCP_SERVER_PORT=3100
COINVERSAA_API_KEY=your-api-key-here
