# Local stack (hardening section 4): demo chain :8545, engine :8000 (serves /riskpilot).
#   make up            start (from demo/frozen/ when present; the first run builds and freezes it)
#   make down          stop
#   make demo-reset    back to the frozen chain state and SQLite copy, same decision ids, < 30 s
#   make demo-freeze   save the running state as the new frozen demo
#   ARC_REHEARSAL=1 make up   also a local Arc stand-in, so Approve and sign -> fund -> settle runs offline
#   make outage-test   kill the engine for real under a headed browser
.PHONY: up down demo-reset demo-freeze preflight arc-setup snapshot hook-volatile outage-test test openapi arc-deploy testnet

up:
	./scripts/stack.sh up
down:
	./scripts/stack.sh down
demo-reset:
	./scripts/stack.sh reset
demo-freeze:
	./scripts/stack.sh freeze
outage-test:
	./scripts/outage-test.sh
# The public page's recording: reset to the frozen block, record every engine and chain response the
# page receives into web/snapshot.json (nexxore.xyz/riskpilot replays it read-only).
snapshot:
	./scripts/stack.sh reset >/dev/null
	cd web && RECORD=1 E2E_EXTERNAL=1 npx playwright test record --reporter=line
	./scripts/stack.sh reset >/dev/null

# PASS/FAIL checks before a demo (after make up and make demo-reset); exits 1 on any FAIL.
preflight:
	./scripts/preflight.sh
# A volatile spell through the live hooked pool: the fee rises toward the cap (VOL_BLOCKS, VOL_ETH).
hook-volatile:
	$(MAKE) -C contracts/hook hook-volatile

test:
	cd engine && ../.venv/bin/python -m pytest -q
	cd shared && ../.venv/bin/python -m pytest -q
	cd web && npx playwright test riskpilot

# docs/openapi.yaml, generated from engine/api.py (the engine serves the same at /v1/openapi.json).
openapi:
	cd engine && ../.venv/bin/python -c 'import yaml; from api import create_app; from store import Store; \
	  print("# Generated by make openapi from engine/api.py; served at /v1/openapi.json.\n" + yaml.safe_dump(create_app(Store(":memory:")).openapi(), sort_keys=False, width=120), end="")' > ../docs/openapi.yaml

# Arc: deploy only, from YOUR wallet (forge prompts; nothing is stored). Settlement is automatic:
# start the engine with ARC_OPERATOR_KEY in its environment (your terminal) and the arc-worker settles.
#   make arc-deploy SENDER=0xYourAddress [WALLET="--account riskpilot"]
SENDER ?=
WALLET ?= --interactive
# Arc testnet in one go: a fresh operator key (.secrets/, gitignored), the escrow deployed by YOUR
# wallet, 1 USDC of operator gas and a 1 USDC reserve. About 4 wallet prompts.
#   make arc-setup SENDER=0xYourAddress [WALLET="--account riskpilot"]
arc-setup:
	@test -n "$(SENDER)" || { echo "usage: make arc-setup SENDER=0xYourAddress [WALLET=--account <name>]"; exit 1; }
	WALLET="$(WALLET)" ./scripts/arc-setup.sh $(SENDER)

arc-deploy:
	@test -n "$(SENDER)" || { echo "usage: make arc-deploy SENDER=0xYourAddress [WALLET=--account <name>]"; exit 1; }
	$(MAKE) -C contracts/arc arc-deploy SENDER=$(SENDER) WALLET="$(WALLET)"

# Public testnets, signed by YOUR wallet: the hook on Unichain Sepolia and the escrow on Arc.
testnet:
	@test -n "$(SENDER)" || { echo "usage: make testnet SENDER=0xYourAddress [WALLET=--account <name>]"; exit 1; }
	$(MAKE) -C contracts/hook deploy-unichain-sepolia SENDER=$(SENDER) WALLET="$(WALLET)"
	$(MAKE) arc-deploy SENDER=$(SENDER) WALLET="$(WALLET)"
