# Copy to .env. Testnet keys only — never put a mainnet key here.

# ── Aqua Options (PRD 3) — Ethereum mainnet fork ────────────────
# Router and Aqua share one address on all 13 Aqua chains (1inch contract-addresses
# page); the fork test checks router.AQUA() == AQUA_REGISTRY on-chain.
# Defaults to https://ethereum-rpc.publicnode.com when unset.
AQUA_FORK_RPC_URL=
AQUA_SWAPVM_ROUTER=0x111111338c5091e8440b67b168bae16a668ac0de
AQUA_REGISTRY=0x1111113ccf1426a8e30e2bff5e005d929bf6a90a

# ── v4 hook (PRD 4) — Uniswap v4 testnet, e.g. Unichain Sepolia ──
V4_RPC_URL=
# TODO(confirm): take from Uniswap's official deployments page only.
V4_POOL_MANAGER=
UNISWAP_API_KEY=

# ── Arc escrow (PRD 5) — Arc testnet ────────────────────────────
# TODO(confirm in Arc docs): RPC URL, chain ID, USDC decimals.
ARC_RPC_URL=
ARC_CHAIN_ID=
ARC_USDC=0x3600000000000000000000000000000000000000

# ── Shared ──────────────────────────────────────────────────────
# Testnet deploys sign with your own wallet: forge/cast --interactive, --ledger or --account.

# ── 0G assistant (PRD 7, backup) ────────────────────────────────
ZG_API_KEY=

# ── Decision log (optional) ─────────────────────────────────────
# Neon Postgres for the hosted agent; empty = SQLite (RISKPILOT_DB). TEST_DATABASE_URL runs the Postgres tests.
DATABASE_URL=
TEST_DATABASE_URL=
