# ═══════════════════════════════════════════════════════════════
#  Nexxore BTC 15-Minute Bot — Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── Mode ─────────────────────────────────────────────────────
# paper = simulated trades, live = real money
TRADING_MODE=paper

# ── Polymarket ───────────────────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=

# ── Data API Keys (optional — enhances signal quality) ──────
COINGLASS_API_KEY=
GLASSNODE_API_KEY=
CRYPTOCOMPARE_API_KEY=
NEWSAPI_KEY=

# ── Risk Parameters ──────────────────────────────────────────
MAX_POSITION_SIZE_USD=500
SIGNAL_THRESHOLD=70
MAX_DAILY_TRADES=20
MAX_DAILY_LOSS_USD=200
INITIAL_CAPITAL=5000

# ── Timing ───────────────────────────────────────────────────
CANDLE_INTERVAL=15m
SCAN_INTERVAL_SECONDS=900
LOOKBACK_CANDLES=96

# ── Monitoring Dashboard ─────────────────────────────────────
DASHBOARD_PORT=3848
DASHBOARD_HOST=0.0.0.0

# ── Notifications (optional) ────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/nexxore_bot.db
