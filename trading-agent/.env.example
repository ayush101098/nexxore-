# Trading Agent Environment Variables

# Mode: 'paper' for testing, 'live' for real trading
TRADING_MODE=paper

# Hyperliquid Configuration
HL_PRIVATE_KEY=your_private_key_here
HL_WALLET_ADDRESS=your_wallet_address_here
HL_TESTNET=true

# Risk Parameters
MAX_RISK_PER_TRADE=0.02
MAX_TOTAL_EXPOSURE=0.20
MAX_DRAWDOWN=0.15
MIN_CONFLUENCE_SCORE=75
MIN_WIN_RATE=0.60

# Portfolio
INITIAL_CAPITAL=10000

# API Keys (optional, for enhanced data)
COINGECKO_API_KEY=
DEFILLAMA_API_KEY=

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Dashboard
DASHBOARD_PORT=3050
