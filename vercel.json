{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/research.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/safe-yield.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/perps.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/perps-analysis.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/perps-intelligence.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/strategy-builder.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/options-data.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/stablecoin.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/vaults-data.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/site.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "js/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/analytics/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/research/(signals|scan|regime|history)",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/research/signal/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/analyst/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/(news|trending|health|signals|alpha-scanner|alpha-scanner-v2)",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/chat",
      "dest": "/api/chat.js"
    },
    {
      "src": "/api/pm/(.*)",
      "dest": "/api/site.js"
    },
    {
      "src": "/api/research/(insights|alpha-scan)",
      "dest": "/api/research.js"
    },
    {
      "src": "/api/safe-yield/(status|strategies|simulate|risk|deposit)",
      "dest": "/api/safe-yield.js"
    },
    {
      "src": "/api/perps/(markets|prices|funding|health|exchange-config|validate-order|log-trade)",
      "dest": "/api/perps.js"
    },
    {
      "src": "/api/perps/(market|orderbook|candles|account|trade-history)/(.*)",
      "dest": "/api/perps.js"
    },
    {
      "src": "/api/perps-analysis",
      "dest": "/api/perps-analysis.js"
    },
    {
      "src": "/api/perps-intelligence",
      "dest": "/api/perps-intelligence.js"
    },
    {
      "src": "/api/strategy-builder",
      "dest": "/api/strategy-builder.js"
    },
    {
      "src": "/api/options-data",
      "dest": "/api/options-data.js"
    },
    {
      "src": "/api/stablecoin",
      "dest": "/api/stablecoin.js"
    },
    {
      "src": "/api/vaults-data",
      "dest": "/api/vaults-data.js"
    },
    {
      "src": "/api/track-record",
      "dest": "/api/site.js"
    },
    {
      "src": "/api/waitlist",
      "dest": "/api/site.js"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "/(?!api/)([^.]+)",
      "dest": "/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}