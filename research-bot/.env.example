# ==============================================
# CRYPTO RESEARCH ANALYST BOT - ENVIRONMENT CONFIG
# ==============================================

# Database (REQUIRED - no defaults provided for security)
DB_HOST=localhost
DB_PORT=5432
DB_USER=research_bot
DB_PASSWORD=your_secure_password_here_REQUIRED
DB_NAME=research_bot

# Legacy variables for backward compatibility
POSTGRES_USER=research_bot
POSTGRES_PASSWORD=your_secure_password_here_REQUIRED
POSTGRES_DB=research_bot
DATABASE_URL=postgresql://research_bot:your_secure_password_here_REQUIRED@localhost:5432/research_bot

# Redis
REDIS_URL=redis://localhost:6379

# CORS Configuration (comma-separated list of allowed origins)
# Example: CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Exchange APIs (Optional - collectors will work in demo mode without these)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_secret
BYBIT_API_KEY=your_bybit_api_key
BYBIT_SECRET=your_bybit_secret
OKX_API_KEY=your_okx_api_key
OKX_SECRET=your_okx_secret
OKX_PASSPHRASE=your_okx_passphrase

# Derivatives Data (Optional)
COINGLASS_API_KEY=your_coinglass_api_key

# On-Chain Data (Optional)
GLASSNODE_API_KEY=your_glassnode_api_key
DEFILLAMA_API_KEY=optional_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# Social & News (Optional)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key
LUNARCRUSH_API_KEY=your_lunarcrush_api_key

# Monitoring
GRAFANA_PASSWORD=admin
SENTRY_DSN=your_sentry_dsn

# App Config
LOG_LEVEL=INFO
ENVIRONMENT=development

# Collection Intervals (in seconds)
INTERVAL_MARKET_DATA=60        # Market data collection (default: 1 minute)
INTERVAL_DERIVATIVES=300       # Derivatives data collection (default: 5 minutes)
INTERVAL_ONCHAIN=3600          # On-chain data collection (default: 1 hour)
INTERVAL_SOCIAL=1800           # Social metrics collection (default: 30 minutes)
INTERVAL_NEWS=900              # News collection (default: 15 minutes)
INTERVAL_FEATURES=300          # Feature computation (default: 5 minutes)
INTERVAL_SIGNALS=300           # Signal generation (default: 5 minutes)

# Signal Generation Thresholds
MIN_CONFIDENCE=0.55            # Minimum confidence score for trade setups (0-1)
MIN_RR_RATIO=1.5               # Minimum risk/reward ratio for trade setups
